#!/usr/bin/env bash
# agents-sync [skill…] — copy org AGENTS.md and skills from JakobMelchard/.agents into ./.agents/.
# No args: every skill. Copies, not symlinks: sandboxed agents do not follow links out of the repo.
set -euo pipefail
. "$(cd "$(dirname "$0")" && pwd)/lib/common.sh"
cd "$(root)"
src=$(fetch .agents)
mkdir -p .agents/skills
cp "$src/AGENTS.md" .agents/AGENTS.org.md
say "  .agents/AGENTS.org.md"
if [ $# -eq 0 ]; then
  set --
  while IFS= read -r __n; do set -- "$@" "$__n"; done < <(cd "$src/skills" && ls)
fi
for s in "$@"; do
  [ -d "$src/skills/$s" ] || die "no such org skill: $s"
  rm -rf ".agents/skills/$s"
  cp -R "$src/skills/$s" ".agents/skills/$s"
  say "  .agents/skills/$s"
done
# Claude Code reads .claude/skills and CLAUDE.md; everything else reads .agents/skills and AGENTS.md.
# One source of truth, relative symlinks for the other convention.
mkdir -p .claude
if [ ! -e .claude/skills ] || [ -L .claude/skills ]; then ln -sfn ../.agents/skills .claude/skills; say "  .claude/skills -> ../.agents/skills"; fi
if [ -f AGENTS.md ] && { [ ! -e CLAUDE.md ] || [ -L CLAUDE.md ]; }; then ln -sfn AGENTS.md CLAUDE.md; say "  CLAUDE.md -> AGENTS.md"; fi
say "synced from $ORG/.agents. Reference .agents/AGENTS.org.md from the repo AGENTS.md."
