#!/usr/bin/env bash
# config-sync [--examples] [group…] — copy org lint/format configs from JakobMelchard/.config into
# this repo per its manifest.json. Groups are the top-level dirs there (eslint prettier tsconfig ruff
# gitleaks editorconfig); no group = all. --examples also seeds release-please/renovate if absent.
set -euo pipefail
. "$(cd "$(dirname "$0")" && pwd)/lib/common.sh"
need jq
cd "$(root)"
src=$(fetch .config)
m="$src/manifest.json"
examples=0; groups=""
for a in "$@"; do case "$a" in --examples) examples=1 ;; *) groups="$groups $a" ;; esac; done
say "config-sync -> $(pwd)"
jq -r '.files | to_entries[] | "\(.key)\t\(.value)"' "$m" | while IFS=$'\t' read -r from to; do
  if [ -n "$groups" ]; then case " $groups " in *" ${from%%/*} "*) ;; *) continue ;; esac; fi
  vendor "$src/$from" "$to" ".config/$from"
done
if [ "$examples" = 1 ]; then
  jq -r '.examples | to_entries[] | "\(.key)\t\(.value)"' "$m" | while IFS=$'\t' read -r from to; do
    if [ -e "$to" ]; then say "  keep $to (exists)"; else cp "$src/$from" "$to"; say "  seed $to"; fi
  done
fi
