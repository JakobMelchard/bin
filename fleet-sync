#!/usr/bin/env bash
# fleet-sync [--dry-run] [repo…] — refresh the vendored org configs in every repo and open one PR
# per repo that changed. Refreshes only what a repo already carries: the config-sync groups whose
# copy exists, plus opt-in groups whose opt-in file exists (tokens: .config/tokens.path). Nothing is
# added to a repo that lacks it. Hooks are not vendored any more: repos pin
# JakobMelchard/.githooks in .pre-commit-config.yaml and Renovate bumps it.
# Repos rendered from JakobMelchard/template (they carry .copier-answers.yml) get only their opt-in
# groups refreshed: their other vendored configs come with the template, via `uvx copier update` or
# Renovate's copier PRs.
# No args: every non-archived repo in .github/infra/settings.json except the platform repos.
# --dry-run prints the diff and pushes nothing.
# Vendors from the latest .config release tag, not main. A file whose only change is the VENDORED
# header line is left alone, so a version bump alone opens no PR. A repo that fails is reported and
# makes the run exit 1 after the other repos are done.
#
# Runs locally with your gh auth (clones over the SSH alias, FLEET_GIT_HOST, default
# github-lilfeelz) or from .github/workflows/fleet-sync.yml with an app token (clones over https,
# gh as the git credential helper, so the token is never in a URL or an argument).
set -euo pipefail
. "$(cd "$(dirname "$0")" && pwd)/lib/common.sh"
need gh git jq

BRANCH=chore/fleet-sync
TITLE="chore: refresh vendored org config"
PLATFORM=" .github .config .githooks .agents bin template "
dry=0; repos=""
for a in "$@"; do case "$a" in --dry-run) dry=1 ;; -*) die "unknown flag $a" ;; *) repos="$repos $a" ;; esac; done
if [ -z "$repos" ]; then
  while IFS= read -r n; do
    case "$PLATFORM" in *" $n "*) ;; *) repos="$repos $n" ;; esac
  done < <(settings_json | jq -r '.repos | to_entries[] | select(.value.archived != true) | .key')
fi

tag=$(gh api "repos/$ORG/.config/releases/latest" -q .tag_name) || die "no release of $ORG/.config"
manifest="$(fetch .config "$tag")/manifest.json"
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
say "fleet-sync from $ORG/.config@$tag"

clone() { # clone <repo> <dir>: https in CI, the SSH alias locally (bare github.com picks the wrong key)
  if [ -n "${GITHUB_ACTIONS:-}" ]; then
    git clone -q --depth 1 -c credential.helper= -c 'credential.helper=!gh auth git-credential' \
      "https://github.com/$ORG/$1.git" "$2"
  else git clone -q --depth 1 "git@${FLEET_GIT_HOST:-github-lilfeelz}:$ORG/$1.git" "$2"; fi
}

unheader='1{/VENDORED from/d;}' # as vendor_check in lib/common.sh
failed=""
for r in $repos; do
  d="$tmp/$r"
  if ! clone "$r" "$d"; then say "$r: clone failed"; failed="$failed $r"; continue; fi
  # errexit is ignored inside a subshell that is part of || or if, so run it bare and read $?
  set +e
  (
    set -e
    cd "$d"
    groups=""
    # templated repos take the fixed files from copier; only their opt-in groups are refreshed here
    if [ ! -f .copier-answers.yml ]; then
      while IFS=$'\t' read -r from to; do
        [ -e "$to" ] && groups="$groups ${from%%/*}"
      done < <(jq -r '.files | to_entries[] | "\(.key)\t\(.value)"' "$manifest")
    fi
    # opt-in groups (tokens): the repo opted in by carrying the named file (.config/tokens.path)
    while IFS=$'\t' read -r from optfile; do
      [ -f "$optfile" ] && groups="$groups ${from%%/*}"
    done < <(jq -r '(.opt_in // {}) | to_entries[] | "\(.key)\t\(.value)"' "$manifest")
    if [ -z "$groups" ] && [ -f .copier-answers.yml ]; then say "$r: templated, skipped (copier update / Renovate)"; exit 0; fi
    # shellcheck disable=SC2086 # space-separated groups by construction
    [ -n "$groups" ] && "$BIN/config-sync" --ref "$tag" $groups >/dev/null
    # a copy whose only change is the VENDORED header line (a version bump) is not a change
    git diff --name-only | while IFS= read -r f; do
      if git show "HEAD:$f" | sed "$unheader" | cmp -s - <(sed "$unheader" "$f"); then git checkout -q -- "$f"; fi
    done
    if [ -z "$(git status --porcelain)" ]; then say "$r: up to date"; exit 0; fi
    say "$r: changed"
    git status --short | sed 's/^/    /'
    [ "$dry" = 1 ] && exit 0
    git checkout -q -B "$BRANCH"
    git add -A
    # --no-verify: the consumer's hooks (and its .local extensions) expect an installed toolchain;
    # this commit is a byte copy of files the hooks themselves come from.
    git -c user.name=fleet-sync -c user.email=fleet-sync@users.noreply.github.com commit -q --no-verify -m "$TITLE"
    git push -q -f origin "$BRANCH"
    if [ -z "$(gh pr list -R "$ORG/$r" --head "$BRANCH" --json number -q '.[].number')" ]; then
      url=$(gh pr create -R "$ORG/$r" --head "$BRANCH" --title "$TITLE" \
        --body "Vendored copies refreshed from \`.config\` $tag by \`fleet-sync\`. Review the diff; the copies are not edited in place.") \
        || { say "    PR not opened"; exit 1; }
      say "    opened PR $url"
      # label is best effort: a repo that has not had `org-repo labels` yet lacks it
      gh pr edit "$url" --add-label fleet/deps >/dev/null 2>&1 || say "    (no fleet/deps label on $r — run org-repo labels)"
    else
      say "    updated existing PR"
    fi
  )
  rc=$?
  set -e
  [ "$rc" = 0 ] || { say "$r: failed"; failed="$failed $r"; }
done
[ -z "$failed" ] || die "failed:$failed"
