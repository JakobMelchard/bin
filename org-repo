#!/usr/bin/env bash
# org-repo — create and align JakobMelchard repos.
#
#   org-repo new <name> --template <hx-app|cf|go|py|c-cpp|infra|ios|macos> [--public] [-d "description"] [--ref <ref>]
#                                    render JakobMelchard/template with copier (every file: CI caller,
#                                    prek config, devcontainer, configs, scaffold), create, push, settings
#   org-repo ls                      names, visibility, archived, default branch
#   org-repo settings [repo…]        drift of live settings vs .github/infra/settings.json
#   org-repo sync [repo…]            apply repo_defaults (+ per-repo overrides) via gh api
#   org-repo apps                    app installations and the repos each one can see
#   org-repo labels [repo…]          create/update the labels declared in settings.json (runs .github/infra/labels)
#
# Source of truth: .github/infra/settings.json. `tofu` in .github/infra applies the same
# document declaratively; `sync` is the imperative path when no admin:org token is around.
set -euo pipefail
. "$(cd "$(dirname "$0")" && pwd)/lib/common.sh"
need gh jq git

# copier template for `new`; --ref picks a tag or branch (default: its latest tag)
TEMPLATE_SRC="${ORG_TEMPLATE_SRC:-https://github.com/$ORG/template.git}"

# keys of repo_defaults that PATCH /repos accepts
PATCH_KEYS='has_issues has_wiki has_projects allow_merge_commit allow_squash_merge allow_rebase_merge delete_branch_on_merge allow_auto_merge allow_update_branch squash_merge_commit_title squash_merge_commit_message web_commit_signoff_required is_template'

desired() { # desired <repo> -> json of the settings that should hold for <repo>
  settings_json | jq --arg r "$1" '.repo_defaults + (.repos[$r] // {}) | with_entries(select(.key != "description" and .key != "topics"))'
}

cmd_ls() {
  gh repo list "$ORG" --limit 200 --json name,visibility,isArchived,defaultBranchRef \
    -q '.[] | "\(.name)\t\(.visibility|ascii_downcase)\t\(if .isArchived then "archived" else "" end)\t\(.defaultBranchRef.name)"' | sort | column -t
}

cmd_settings() {
  if [ $# -eq 0 ]; then
    set --
    while IFS= read -r __n; do set -- "$@" "$__n"; done < <(gh repo list "$ORG" --limit 200 --json name -q '.[].name' | sort)
  fi
  rc=0
  for r in "$@"; do
    want=$(desired "$r"); live=$(gh api "repos/$ORG/$r")
    # vulnerability_alerts is not a /repos attribute: 204 = on, 404 = off
    if gh api "repos/$ORG/$r/vulnerability-alerts" >/dev/null 2>&1; then va=true; else va=false; fi
    # private_vulnerability_reporting has its own endpoint too; only public repos have it (else false)
    pvr=$(gh api "repos/$ORG/$r/private-vulnerability-reporting" -q '.enabled' 2>/dev/null || echo false)
    live=$(printf '%s' "$live" | jq --argjson va "$va" --argjson pvr "$pvr" '. + {vulnerability_alerts: $va, private_vulnerability_reporting: $pvr}')
    # `has`, not `//`: a live value of false must compare as false, not null
    diff=$(jq -n --argjson w "$want" --argjson l "$live" '
      [ $w | to_entries[] | select(.key as $k | (if $l | has($k) then $l[$k] else null end) != .value) | "\(.key): live=\($l[.key]) want=\(.value)" ] | .[]' -r)
    if [ -n "$diff" ]; then rc=1; say "$r"; say "$diff" | sed 's/^/    /'; fi
  done
  [ $rc -eq 0 ] && say "no drift"
  return $rc
}

cmd_sync() {
  if [ $# -eq 0 ]; then
    set --
    while IFS= read -r __n; do set -- "$@" "$__n"; done < <(gh repo list "$ORG" --limit 200 --json name,isArchived -q '.[] | select(.isArchived|not) | .name' | sort)
  fi
  for r in "$@"; do
    body=$(desired "$r" | jq --arg keys "$PATCH_KEYS visibility archived" 'with_entries(select(.key as $k | ($keys | split(" ")) | index($k)))')
    say "$r: $(printf '%s' "$body" | jq -c .)"
    gh api -X PATCH "repos/$ORG/$r" --input - <<<"$body" >/dev/null
    # dependabot alerts are a separate endpoint
    if [ "$(desired "$r" | jq -r '.vulnerability_alerts // empty')" = "true" ]; then
      gh api -X PUT "repos/$ORG/$r/vulnerability-alerts" >/dev/null 2>&1 || true
    fi
    # private vulnerability reporting: separate endpoint, public repos only, set when the key is present
    case "$(desired "$r" | jq -r '.private_vulnerability_reporting // empty')" in
      true)  gh api -X PUT "repos/$ORG/$r/private-vulnerability-reporting" >/dev/null 2>&1 || say "  $r: private vulnerability reporting not enabled (public repos only)" ;;
      false) gh api -X DELETE "repos/$ORG/$r/private-vulnerability-reporting" >/dev/null 2>&1 || true ;;
    esac
  done
}

cmd_labels() { # the script lives next to settings.json so labels.yml in .github runs the same code
  local d; d=$(fetch .github)
  ORG="$ORG" bash "$d/infra/labels" "$@"
}

cmd_apps() {
  gh api "orgs/$ORG/installations" -q '.installations[] | "\(.id)\t\(.app_slug)\t\(.repository_selection)"' | while IFS=$'\t' read -r id slug sel; do
    if [ "$sel" = "all" ]; then say "$slug: all"; continue; fi
    # user/installations/<id>/repositories needs a PAT or an app token; gh's OAuth token gets a
    # 403 whose body lands on stdout. Under pipefail that failure used to end the whole loop.
    if out=$(gh api "user/installations/$id/repositories" -q '.repositories[].name' 2>/dev/null); then
      say "$slug: $(printf '%s' "$out" | tr '\n' ' ')"
    else
      say "$slug: selected repos (list needs a PAT)"
    fi
  done
}

cmd_new() {
  local name="" tpl="" vis=--private desc="" ref=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --template) tpl=$2; shift 2 ;;
      --ref)      ref=$2; shift 2 ;;
      --public)   vis=--public; shift ;;
      -d)         desc=$2; shift 2 ;;
      -*)         die "unknown flag $1" ;;
      *)          name=$1; shift ;;
    esac
  done
  [ -n "$name" ] && [ -n "$tpl" ] || die "usage: org-repo new <name> --template <t> [--public] [-d desc] [--ref <template ref>]"
  need uvx
  local dir="$WS/$name"
  [ -e "$dir" ] && die "$dir exists"

  # Render first: a bad template name or answer fails here, before anything exists on GitHub.
  # No --trust: the template uses no unsafe copier features (see its README).
  uvx copier copy --quiet --defaults \
    --data template="$tpl" --data name="$name" --data description="${desc:-TODO}" \
    ${ref:+--vcs-ref "$ref"} "$TEMPLATE_SRC" "$dir" || die "copier copy failed; nothing was created on GitHub"
  say "rendered $TEMPLATE_SRC ($tpl) -> $dir"
  cd "$dir"
  git init -q -b main
  git add -A && git commit -q -m "chore: scaffold from $ORG/template ($tpl)"

  gh repo create "$ORG/$name" $vis ${desc:+-d "$desc"} --source=. --remote=origin >/dev/null
  say "created $ORG/$name ($vis)"
  if command -v prek >/dev/null; then prek install >/dev/null; else say "note: prek not installed, hooks skipped (brew install prek && prek install)"; fi
  git push -q -u origin main
  cmd_sync "$name"
  say
  say "next: add \"$name\" to .github/infra/settings.json repos (or leave it on repo_defaults) and open the first PR."
  say "template updates: uvx copier update --defaults (Renovate opens them as PRs from .copier-answers.yml)."
}

case "${1:-}" in
  new)      shift; cmd_new "$@" ;;
  ls)       cmd_ls ;;
  settings) shift; cmd_settings "$@" ;;
  sync)     shift; cmd_sync "$@" ;;
  apps)     cmd_apps ;;
  labels)   shift; cmd_labels "$@" ;;
  *)        sed -n '2,15p' "$0" >&2; exit 2 ;;
esac
